# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional. Any Claude model ID works; the code does not depend on the model.
CLAUDE_MODEL=claude-fable-5-2

# Optional cost controls
# TARIFF_MAX_LLM_DOCS=25        # read at most this many notices with the LLM per run
# TARIFF_MAX_DOC_CHARS=80000    # characters of each notice sent to the LLM
# TARIFF_OFFLINE=1              # never call the LLM
